PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/impactlens
MONGODB_USERNAME=
MONGODB_PASSWORD=
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_MODE=auto
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=
OPEN_ROUTER_API_KEY=
API_MODEL_1_NAME=
API_MODEL_2_NAME=
API_MODEL_3_NAME=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Requests per minute to Gemini (free tier ~10)
GEMINI_RPM=8
# Optional model pool; free-tier quotas are per model per day (e.g. 20)
GEMINI_MODELS=
# Semantic search embeddings (Gemini)
EMBEDDING_MODEL=gemini-embedding-001
CLIENT_URL=http://localhost:3000
PUBLIC_REPORT_BASE_URL=http://localhost:3000/reports
# Browser session cookie: lax (same-site deploy, default) | none (API on another site; requires HTTPS)
COOKIE_SAMESITE=lax
SESSION_MAX_AGE_MS=604800000
MAX_UPLOAD_MB=50
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Deployment behind proxies (Vercel -> Render): number of trusted proxy hops
TRUST_PROXY=
# Local media fallback when Cloudinary isn't configured (served at /api/uploads)
UPLOADS_DIR=
