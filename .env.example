# ---- Server ----
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/impactlens

# JWT
JWT_SECRET=replace_me
JWT_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI provider (pick whichever the team is using; keep the key name generic
# so server/services/ai/ stays provider-agnostic where possible)
AI_PROVIDER=gemini            # gemini | groq | openai | local
AI_API_KEY=

# Client (Vite/CRA — adjust prefix to whatever bundler is chosen)
VITE_API_BASE_URL=http://localhost:5000/api

# Public report base URL (used to build shareable links)
PUBLIC_REPORT_BASE_URL=http://localhost:3000/reports
