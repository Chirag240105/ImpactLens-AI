# Server
PORT=5000
NODE_ENV=development

# MongoDB (required)
MONGODB_URI=mongodb://localhost:27017/impactlens
# Optional legacy URI components (MONGODB_URI remains the connection setting)
MONGODB_USERNAME=
MONGODB_PASSWORD=

# JWT (required; use a long random value outside development)
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Cloudinary (optional; leave blank to use demo placeholder media)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Set mock to use local placeholder URLs even when real credentials exist
CLOUDINARY_MODE=auto

# AI: gemini | groq | openai | mock; mock is selected when key is missing
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=
# Legacy provider compatibility for existing local environments
OPEN_ROUTER_API_KEY=
API_MODEL_1_NAME=
API_MODEL_2_NAME=
API_MODEL_3_NAME=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Requests per minute to Gemini (free tier ~10)
GEMINI_RPM=8
# Optional model pool; free-tier quotas are per model per day (e.g. 20)
GEMINI_MODELS=

# Browser / sharing
CLIENT_URL=http://localhost:3000
PUBLIC_REPORT_BASE_URL=http://localhost:3000/reports
# Browser session cookie: lax (same-site deploy, default) | none (API on another site; requires HTTPS)
COOKIE_SAMESITE=lax
SESSION_MAX_AGE_MS=604800000

# Limits
MAX_UPLOAD_MB=50
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Optional legacy client setting
VITE_API_BASE_URL=http://localhost:5000/api

# Deployment behind proxies (Vercel -> Render): number of trusted proxy hops
TRUST_PROXY=
# Local media fallback when Cloudinary isn't configured (served at /api/uploads)
UPLOADS_DIR=
