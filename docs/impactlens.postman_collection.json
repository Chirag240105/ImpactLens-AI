{
  "info": { "name": "ImpactLens AI API", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json" },
  "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
  "variable": [{ "key": "base", "value": "http://localhost:5000/api" }, { "key": "token", "value": "" }, { "key": "projectId", "value": "" }, { "key": "mediaId", "value": "" }, { "key": "reportId", "value": "" }, { "key": "slug", "value": "" }],
  "item": [
    { "name": "Health", "request": { "method": "GET", "url": "{{base}}/health" } },
    { "name": "Auth register", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"name\":\"Demo User\",\"email\":\"new@example.test\",\"password\":\"StrongPass123\"}" }, "url": "{{base}}/auth/register" } },
    { "name": "Auth login", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"manager@impactlens.demo\",\"password\":\"Manager123!\"}" }, "url": "{{base}}/auth/login" } },
    { "name": "Auth me", "request": { "method": "GET", "url": "{{base}}/auth/me" } },
    { "name": "Auth logout", "request": { "method": "POST", "url": "{{base}}/auth/logout" } },
    { "name": "Projects list", "request": { "method": "GET", "url": "{{base}}/projects?page=1&limit=20" } },
    { "name": "Projects create", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"name\":\"Example restoration\",\"organization\":\"Demo NGO\"}" }, "url": "{{base}}/projects" } },
    { "name": "Project get", "request": { "method": "GET", "url": "{{base}}/projects/{{projectId}}" } },
    { "name": "Project update", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"status\":\"ACTIVE\"}" }, "url": "{{base}}/projects/{{projectId}}" } },
    { "name": "Project archive", "request": { "method": "DELETE", "url": "{{base}}/projects/{{projectId}}" } },
    { "name": "Project analyze", "request": { "method": "POST", "url": "{{base}}/projects/{{projectId}}/analyze" } },
    { "name": "Project processing status", "request": { "method": "GET", "url": "{{base}}/projects/{{projectId}}/processing-status" } },
    { "name": "Project dashboard", "request": { "method": "GET", "url": "{{base}}/projects/{{projectId}}/dashboard" } },
    { "name": "Project timeline", "request": { "method": "GET", "url": "{{base}}/projects/{{projectId}}/timeline" } },
    { "name": "Project locations", "request": { "method": "GET", "url": "{{base}}/projects/{{projectId}}/locations" } },
    { "name": "Project coverage", "request": { "method": "GET", "url": "{{base}}/projects/{{projectId}}/coverage" } },
    { "name": "Project comparisons", "request": { "method": "GET", "url": "{{base}}/projects/{{projectId}}/comparisons" } },
    { "name": "Project pairs", "request": { "method": "GET", "url": "{{base}}/projects/{{projectId}}/pair-suggestions" } },
    { "name": "Project insights", "request": { "method": "GET", "url": "{{base}}/projects/{{projectId}}/insights" } },
    { "name": "Generate insights", "request": { "method": "POST", "url": "{{base}}/projects/{{projectId}}/insights/generate" } },
    { "name": "Project reports", "request": { "method": "GET", "url": "{{base}}/projects/{{projectId}}/reports" } },
    { "name": "Sign upload (disabled)", "request": { "method": "POST", "url": "{{base}}/media/sign" } },
    { "name": "Media upload", "request": { "method": "POST", "body": { "mode": "formdata", "formdata": [{ "key": "projectId", "value": "{{projectId}}", "type": "text" }, { "key": "files", "type": "file", "src": "" }] }, "url": "{{base}}/media/upload" } },
    { "name": "Media list", "request": { "method": "GET", "url": "{{base}}/media?projectId={{projectId}}&page=1&limit=20" } },
    { "name": "Media detail", "request": { "method": "GET", "url": "{{base}}/media/{{mediaId}}" } },
    { "name": "Media update", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"evidenceType\":\"FOLLOW_UP\"}" }, "url": "{{base}}/media/{{mediaId}}" } },
    { "name": "Media delete", "request": { "method": "DELETE", "url": "{{base}}/media/{{mediaId}}" } },
    { "name": "Media analyze retry", "request": { "method": "POST", "url": "{{base}}/media/{{mediaId}}/analyze" } },
    { "name": "Search", "request": { "method": "GET", "url": "{{base}}/search?q=plantation&projectId={{projectId}}" } },
    { "name": "Compare", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"beforeId\":\"{{mediaId}}\",\"afterId\":\"{{mediaId}}\"}" }, "url": "{{base}}/analysis/compare" } },
    { "name": "Insight trace", "request": { "method": "GET", "url": "{{base}}/insights/{{mediaId}}/trace" } },
    { "name": "Dashboard overview", "request": { "method": "GET", "url": "{{base}}/dashboard/overview" } },
    { "name": "Generate report", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"projectId\":\"{{projectId}}\"}" }, "url": "{{base}}/reports/generate" } },
    { "name": "Generate story", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"projectId\":\"{{projectId}}\"}" }, "url": "{{base}}/reports/story" } },
    { "name": "Generate campaign", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"projectId\":\"{{projectId}}\"}" }, "url": "{{base}}/reports/campaign" } },
    { "name": "Report get", "request": { "method": "GET", "url": "{{base}}/reports/{{reportId}}" } },
    { "name": "Report PDF", "request": { "method": "GET", "url": "{{base}}/reports/{{reportId}}/pdf" } },
    { "name": "Report publish", "request": { "method": "PATCH", "url": "{{base}}/reports/{{reportId}}/publish" } },
    { "name": "Public report", "request": { "method": "GET", "url": "{{base}}/reports/public/{{slug}}", "auth": { "type": "noauth" } } }
  ]
}
